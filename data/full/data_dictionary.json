   "message_id"
  ],
  "id_regex": "MSG-CART-2026-\\d{6}-\\d{2}",
  "fks": [
   [
    "cart_id",
    "carts",
    "cart_id"
   ],
   [
    "customer_id",
    "customers",
    "customer_id"
   ],
   [
    "campaign_id",
    "campaigns",
    "campaign_id"
   ],
   [
    "template_id",
    "message_templates",
